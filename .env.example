# Public hostname. Caddy gets a Let's Encrypt certificate for exactly this
# name, and the 42 redirect URI is derived from it.
SITE_DOMAIN=guess.example.com

# Create the application at https://profile.intra.42.fr/oauth/applications/new
# and register https://<SITE_DOMAIN>/auth/callback as a redirect URI.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Comma-separated 42 logins who get /admin. Setting this makes the instance a
# TEST instance: warning banner on every page, clock controls, stand-in
# players. Leave it EMPTY on the live site.
ADMIN_LOGINS=

# --- local development only (compose overrides all of these) ---------------
# FT_REDIRECT_URI=http://localhost:3000/auth/callback
# DATABASE_URL=sqlite://data/game.db
# BIND_ADDR=127.0.0.1:3000
# SECURE_COOKIES=false
# RUST_LOG=i_guess_42=info
