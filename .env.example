# Copy to .env and fill in. .env is git-ignored; never commit it.

# Your own 42 application: https://profile.intra.42.fr/oauth/applications/new
# Redirect URI for local development: http://localhost:3000/auth/callback
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Comma-separated 42 logins who get /admin. Setting this makes the instance a
# TEST instance: warning banner on every page, clock controls, demo players
# and demo history. Put your own login here for local development; the live
# site keeps it EMPTY.
ADMIN_LOGINS=

# 42 campus ids allowed to play, matched against each player's primary
# campus. 53 is 42 Vienna. Leave empty to allow every campus.
# ALLOWED_CAMPUS_IDS=53

# Key for the 42 Vienna coalition points API, which after 12:42 pays everyone
# who played the round that just closed, and more to the player who won it
# (https://iglcp-api.42vienna.com/docs). Sent as-is in the
# Authorization header, so include a scheme like "Bearer " if it needs one.
# Leave empty to pay nothing. Ignored on a test instance (ADMIN_LOGINS set),
# so local runs never hand out real points.
IGLCP_API_KEY=

# --- signing in without 42 (all optional) -------------------------------------
# Each way in appears only when its keys are set.
# GitHub: https://github.com/settings/developers -> OAuth Apps.
#   Callback URL: http://localhost:3000/auth/github/callback (or your domain)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com -> APIs & Services -> Credentials
#   -> OAuth client ID (Web). Redirect URI: http://localhost:3000/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Mail for email sign-up (https://resend.com). Without it a test instance
# prints each mail, link and all, to the log instead.
# RESEND_API_KEY=
# MAIL_FROM=i guess low <noreply@iguesslow.com>
# Random text; hashes client addresses so moderators can spot one person
# with many accounts. Without it nothing address-derived is stored.
# IP_HASH_KEY=
# 42 logins who may moderate the global round at /mod.
# MODERATORS=
# The sign-up robot check is self-hosted; this only tunes how hard it is.
# CAPTCHA_BITS=18
# The key /leaderboard.png?key=... needs (for a screen or a bot). Long random
# text. Empty: nobody gets the image.
# LEADERBOARD_IMAGE_KEY=
# Shown on /imprint.
# IMPRINT_NAME=
# IMPRINT_ADDRESS=
# IMPRINT_EMAIL=

# --- optional, local defaults shown ------------------------------------------
# FT_REDIRECT_URI=http://localhost:3000/auth/callback
# DATABASE_URL=sqlite://data/game.db
# BIND_ADDR=127.0.0.1:3000
# SECURE_COOKIES=false
# RUST_LOG=i_guess_42=info
# IGLCP_API_URL=https://iglcp-api.42vienna.com

# --- production (docker compose) only -----------------------------------------
# The public hostname. Caddy gets a certificate for it, and compose derives
# the redirect URI https://<SITE_DOMAIN>/auth/callback from it.
# SITE_DOMAIN=iguesslow.com
