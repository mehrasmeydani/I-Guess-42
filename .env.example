# Copy to .env and fill in. .env is git-ignored; never commit it.

# Your own 42 application: https://profile.intra.42.fr/oauth/applications/new
# Redirect URI for local development: http://localhost:3000/auth/callback
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Comma-separated 42 logins who get /admin. Setting this makes the instance a
# TEST instance: warning banner on every page, clock controls, demo players
# and demo history. Put your own login here for local development; the live
# site keeps it EMPTY.
ADMIN_LOGINS=

# 42 campus ids allowed to play, matched against each player's primary
# campus. 53 is 42 Vienna. Leave empty to allow every campus.
# ALLOWED_CAMPUS_IDS=53

# --- optional, local defaults shown ------------------------------------------
# FT_REDIRECT_URI=http://localhost:3000/auth/callback
# DATABASE_URL=sqlite://data/game.db
# BIND_ADDR=127.0.0.1:3000
# SECURE_COOKIES=false
# RUST_LOG=i_guess_42=info

# --- production (docker compose) only -----------------------------------------
# The public hostname. Caddy gets a certificate for it, and compose derives
# the redirect URI https://<SITE_DOMAIN>/auth/callback from it.
# SITE_DOMAIN=iguesslow.com
